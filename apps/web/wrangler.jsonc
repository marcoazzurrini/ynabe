{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ynabe",
  "account_id": "168a8fd9b88ae669c145fa229de911c5",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The app lives on its own subdomain. The workers.dev address is off,
  // because sign-in and passkeys only work on the one origin in
  // BETTER_AUTH_URL.
  "workers_dev": false,
  "routes": [{ "pattern": "ynabe.marcoazzurrini.com", "custom_domain": true }],
  // Every deploy would otherwise get its own extra preview address.
  "preview_urls": false,
  "observability": { "enabled": true },
  // The bank sync. Synci refreshes from the banks every six hours on
  // the Basic plan, so asking more often brings nothing new.
  // The second one keeps the assistant's runner awake, so no message
  // waits for its container to start.
  "triggers": { "crons": ["15 */6 * * *", "*/5 * * * *"] },
  // GOOGLE_CLIENT_SECRET, BETTER_AUTH_SECRET, SYNCI_API_TOKEN and
  // CLAUDE_CODE_OAUTH_TOKEN are Worker secrets, set with
  // `wrangler secret put`. Local development
  // reads them, and the vars below, from .dev.vars (see .dev.vars.example).
  "vars": {
    "AUTH_ALLOWED_EMAILS": "marco.azzurrini.art@gmail.com",
    "BETTER_AUTH_URL": "https://ynabe.marcoazzurrini.com",
    "GOOGLE_CLIENT_ID": "462635110749-7d3uhf6kuundauhq2p6aiufib9jnaltv.apps.googleusercontent.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ynabe",
      "database_id": "2149dc7f-53c0-4cef-bebc-33c2e7a87013",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // The assistant's runner: Claude Code in a container, started when a
  // run needs it. Workers cannot run Claude Code themselves.
  "containers": [
    {
      "class_name": "AgentRunner",
      "scheduling_policy": "durable_object",
      "images": { "runner": { "dockerfile": "../agent/Dockerfile" } },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "AGENT_RUNNER", "class_name": "AgentRunner" }],
  },
  "exports": {
    "AgentRunner": { "type": "durable-object", "storage": "sqlite" },
  },
  // Local development needs no Docker: start the runner by hand and
  // point AGENT_URL at it (see the README).
  "dev": { "enable_containers": false },
}
